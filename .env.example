# Root .env for docker compose — copy to .env and fill in both values.
#
# First-run bootstrap (LSP_1_NODE_ID is generated by lsp-service on first start):
#
#   1. docker compose up lsp-service
#   2. Wait for "LSP node ID : <hex>" in the output (a few seconds after chain sync)
#   3. Paste that hex string as LSP_1_NODE_ID below
#   4. docker compose up
#
# On subsequent runs the seed is persisted in the lsp-data volume so the
# node ID stays the same — step 1-3 are only needed once.

LSP_1_NODE_ID=

# Arbitrary string used to authenticate requests to node-service's admin API
ADMIN_API_KEY=changeme
