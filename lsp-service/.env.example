# Network: mutinynet | signet | testnet | bitcoin
NETWORK=mutinynet

ESPLORA_URL=https://mutinynet.com/api

# Address and port the LSP node binds on for Lightning peer connections
LISTEN_ADDRESS=127.0.0.1:9737

# Peer-reachable address printed in startup instructions for node-service.
# Set this when LISTEN_ADDRESS is 0.0.0.0 or behind NAT (e.g. your public IP/hostname).
# Defaults to LISTEN_ADDRESS when unset, which is correct for local/dev use.
# ADVERTISE_ADDRESS=203.0.113.10:9737

# Directory where ldk-node stores channel state, wallet data, and the seed file
STORAGE_DIR=./data/lsp

# Optional: require clients to present this token when requesting a JIT channel.
# Leave empty to allow any client.
LSPS2_TOKEN=

# LSPS2 fee parameters (all have the defaults shown here)
LSPS2_ADVERTISE_SERVICE=true
LSPS2_CHANNEL_OPENING_FEE_PPM=10000
LSPS2_CHANNEL_OVER_PROVISIONING_PPM=250000
LSPS2_MIN_CHANNEL_OPENING_FEE_MSAT=0
LSPS2_MIN_CHANNEL_LIFETIME=144
LSPS2_MAX_CLIENT_TO_SELF_DELAY=1024
LSPS2_MIN_PAYMENT_SIZE_MSAT=1000
LSPS2_MAX_PAYMENT_SIZE_MSAT=100000000000
